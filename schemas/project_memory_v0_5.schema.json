{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-history/project_memory_v0_5.schema.json",
  "title": "Project History Agent Memory v0.5",
  "type": "object",
  "required": ["schema", "project", "sources", "locations", "chats", "plans", "versions", "visuals", "development_lines", "events", "search_queue", "conflicts", "handoff"],
  "properties": {
    "schema": {"const": "project-history-state/v0.5"},
    "project": {"type": "object", "required": ["project_id", "name", "goal", "constraints"], "properties": {"project_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "goal": {"type": "string"}, "canonical_version": {"type": ["string", "null"]}, "constraints": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "sources": {"type": "array", "items": {"type": "object", "required": ["source_id"], "properties": {"source_id": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "locations": {"type": "array", "items": {"type": "object", "required": ["location_id", "location_key", "kind", "uri", "observed_now"], "additionalProperties": true}},
    "chats": {"type": "array", "items": {"type": "object", "required": ["chat_id", "classification", "source_ids"], "properties": {"classification": {"enum": ["new", "continuation", "unknown"]}}, "additionalProperties": true}},
    "plans": {"type": "array", "items": {"type": "object", "required": ["plan_id", "source_ids"], "additionalProperties": true}},
    "versions": {"type": "array", "items": {"type": "object", "required": ["version_id", "source_ids"], "additionalProperties": true}},
    "visuals": {"type": "array", "items": {"type": "object", "required": ["visual_id", "kind", "uri", "source_ids", "observed_now"], "additionalProperties": true}},
    "development_lines": {"type": "array"}, "events": {"type": "array"}, "search_queue": {"type": "array"}, "conflicts": {"type": "array"}, "handoff": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
